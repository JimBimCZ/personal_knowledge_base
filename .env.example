# Copy to .env before running: cp .env.example .env
# .env is git-ignored. Never commit real values.

# --- Database -----------------------------------------------------------
# Used by the postgres container to initialise itself.
POSTGRES_USER=pkb
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=pkb

# Used by the app. Host is the compose service name, not localhost.
DATABASE_URL=postgres://pkb:local-dev-only-change-me@db:5432/pkb

# --- Logging ------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Identity (OIDC) ----------------------------------------------------
# No provider name appears anywhere in the code. To swap the local mock IdP
# for Microsoft Entra ID, change the five OIDC_* values below and drop
# OIDC_INTERNAL_ORIGIN. See README → "Swapping the IdP".

# Session cookie encryption. Generate a real one with: openssl rand -base64 32
AUTH_SECRET=local-dev-only-change-me-at-least-16-chars
AUTH_URL=http://localhost:3000

# The issuer as the BROWSER sees it. This is what lands in the token's `iss`.
OIDC_ISSUER=http://localhost:8080/realms/pkb
OIDC_CLIENT_ID=pkb-app
OIDC_CLIENT_SECRET=local-dev-only-change-me-client-secret
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles

# Local-Docker only: the server reaches Keycloak on the container network,
# while the browser reaches it on localhost. Unset this for a public IdP.
OIDC_INTERNAL_ORIGIN=http://keycloak:8080

# --- Local mock IdP (Keycloak) ------------------------------------------
# Console at http://localhost:8080. Not used by the app itself.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me

# --- Embeddings ---------------------------------------------------------
# local = model runs in-process, no text leaves the app to be embedded.
# mock  = deterministic hashing, no model. Retrieval degrades to keyword
#         matching, which is what makes the app demoable with no model present.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.models

# --- Answering (LLM) ----------------------------------------------------
# mock      = no key, no network. Extracts the best-matching sentences from the
#             retrieved chunks and cites them. The default, so `docker compose
#             up` is fully demoable with nothing configured.
# anthropic = the real run. Requires ANTHROPIC_API_KEY.
# gateway   = a corporate AI Gateway. Requires LLM_GATEWAY_BASE_URL.
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5
# Wall-clock deadline for one model call. The request is aborted, not abandoned.
LLM_TIMEOUT_MS=60000

# Leave blank unless LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Leave blank unless LLM_PROVIDER=gateway. The gateway holds the vendor key;
# LLM_GATEWAY_API_KEY authenticates this app TO the gateway.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=

# --- Retrieval ----------------------------------------------------------
# How many chunks are put in front of the model.
RAG_TOP_K=6
# Cosine similarity floor. Below this the app answers "Not found in your
# knowledge base." rather than passing weak matches to the model.
RAG_MIN_SCORE=0.25
