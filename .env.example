# Copy to .env before running: cp .env.example .env
# .env is git-ignored. Never commit real values.

# --- Database -----------------------------------------------------------
# Used by the postgres container to initialise itself.
POSTGRES_USER=pkb
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=pkb

# Used by the app. Host is the compose service name, not localhost.
DATABASE_URL=postgres://pkb:local-dev-only-change-me@db:5432/pkb

# --- Logging ------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Identity (OIDC) ----------------------------------------------------
# No provider name appears anywhere in the code. To swap the local mock IdP
# for Microsoft Entra ID, change the five OIDC_* values below and drop
# OIDC_INTERNAL_ORIGIN. See README → "Swapping the IdP".

# Session cookie encryption. Generate a real one with: openssl rand -base64 32
AUTH_SECRET=local-dev-only-change-me-at-least-16-chars
AUTH_URL=http://localhost:3000

# The issuer as the BROWSER sees it. This is what lands in the token's `iss`.
OIDC_ISSUER=http://localhost:8080/realms/pkb
OIDC_CLIENT_ID=pkb-app
OIDC_CLIENT_SECRET=local-dev-only-change-me-client-secret
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles

# Local-Docker only: the server reaches Keycloak on the container network,
# while the browser reaches it on localhost. Unset this for a public IdP.
OIDC_INTERNAL_ORIGIN=http://keycloak:8080

# --- Local mock IdP (Keycloak) ------------------------------------------
# Console at http://localhost:8080. Not used by the app itself.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me
